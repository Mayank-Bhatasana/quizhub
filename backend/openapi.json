{
  "openapi": "3.0.3",
  "info": {
    "title": "Quiz Backend API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/guest": {
      "post": {
        "summary": "Create or load guest profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "displayName": {
                    "type": "string"
                  }
                },
                "required": [
                  "displayName"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Guest profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/questions": {
      "post": {
        "summary": "Create question",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateQuestionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Question created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/rooms": {
      "post": {
        "summary": "Create room",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoomRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Room created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/rooms/{code}/join": {
      "post": {
        "summary": "Join room",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinRoomRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Joined",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinRoomResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/rooms/{code}/participants": {
      "get": {
        "summary": "get the num of parametersi",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Joined",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinRoomResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/rooms/{roomId}/answer": {
      "post": {
        "summary": "Submit answer",
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/rooms/{roomId}/scoreboard": {
      "get": {
        "summary": "Get scoreboard",
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scores",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreboardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/questions/{id}": {
      "patch": {
        "summary": "Update a saved question",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated question"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "summary": "Soft-delete a saved question",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
    "/api/profiles/{profileId}/questions": {
      "get": {
        "summary": "Get a profile's saved question bank",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeInactive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Question bank"
          }
        }
      }
    },
    "/api/rooms/{code}/kick": {
      "post": {
        "summary": "Remove a participant (host only)",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Participant removed"
          },
          "403": {
            "description": "Not the host"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/rooms/{code}/end": {
      "post": {
        "summary": "End the quiz immediately (host only)",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quiz ended"
          },
          "403": {
            "description": "Not the host"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/rooms/{code}/analytics": {
      "get": {
        "summary": "Session report: per-question breakdown and scores",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session analytics"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/docs": {
      "get": {
        "summary": "OpenAPI spec",
        "responses": {
          "200": {
            "description": "OpenAPI JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/curated-quizzes": {
      "get": {
        "summary": "List curated quizzes",
        "description": "Public list of the platform's curated \"Quizzes by us\" (no answers).",
        "responses": {
          "200": {
            "description": "Curated quizzes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CuratedQuizListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/curated-quizzes/{slug}": {
      "get": {
        "summary": "Get curated quiz",
        "description": "Full curated quiz with questions, options and answers. Requires an authenticated session.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Curated quiz",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CuratedQuizResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "username": {
                "type": "string",
                "nullable": true
              },
              "avatarUrl": {
                "type": "string",
                "nullable": true
              },
              "role": {
                "type": "string"
              },
              "totalPoints": {
                "type": "integer"
              },
              "isTemporary": {
                "type": "boolean"
              },
              "guestToken": {
                "type": "string",
                "nullable": true
              },
              "createdAt": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string"
              }
            }
          }
        }
      },
      "CreateQuestionRequest": {
        "type": "object",
        "properties": {
          "createdById": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "SINGLE",
              "MULTIPLE",
              "TRUE_FALSE"
            ],
            "description": "Question type. Defaults to SINGLE."
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "isCorrect": {
                  "type": "boolean"
                },
                "sortOrder": {
                  "type": "integer"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        },
        "required": [
          "createdById",
          "text",
          "options"
        ]
      },
      "QuestionResponse": {
        "type": "object",
        "properties": {
          "question": {
            "type": "object"
          }
        }
      },
      "CreateRoomRequest": {
        "type": "object",
        "properties": {
          "hostProfileId": {
            "type": "string"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "questionId": {
                  "type": "string"
                },
                "points": {
                  "type": "integer"
                },
                "orderIndex": {
                  "type": "integer"
                }
              },
              "required": [
                "questionId"
              ]
            }
          }
        },
        "required": [
          "hostProfileId",
          "questions"
        ]
      },
      "RoomResponse": {
        "type": "object",
        "properties": {
          "room": {
            "type": "object"
          }
        }
      },
      "JoinRoomRequest": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "profileId",
          "displayName"
        ]
      },
      "JoinRoomResponse": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string"
          },
          "participant": {
            "type": "object"
          }
        }
      },
      "SubmitAnswerRequest": {
        "type": "object",
        "properties": {
          "participantId": {
            "type": "string"
          },
          "roomQuestionId": {
            "type": "string"
          },
          "selectedOptionId": {
            "type": "string",
            "nullable": true
          },
          "selectedOptionIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "All selected option ids (for MULTIPLE questions)."
          },
          "timeTakenSeconds": {
            "type": "integer"
          }
        },
        "required": [
          "participantId",
          "roomQuestionId"
        ]
      },
      "AnswerResponse": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "object"
          }
        }
      },
      "ScoreboardResponse": {
        "type": "object",
        "properties": {
          "scoreboard": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "participantId": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "score": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "CuratedQuizListResponse": {
        "type": "object",
        "properties": {
          "quizzes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "emoji": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "questionCount": {
                  "type": "integer"
                },
                "totalPoints": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "CuratedQuizResponse": {
        "type": "object",
        "properties": {
          "quiz": {
            "type": "object"
          }
        }
      }
    }
  }
}
